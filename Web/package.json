{
  "name": "miller-avatar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.0",
    "npm": "10.9.4"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "toolchain:check": "node scripts/build-tests.mjs --check-toolchain",
    "dependencies:check": "node scripts/verify-dependencies.mjs",
    "build:test": "node scripts/build-tests.mjs",
    "test:contract": "npm run build:test && node .build/contract.test.mjs",
    "test": "npm run toolchain:check && npm run dependencies:check && npm run build:test && node --test .build/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run toolchain:check"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.180.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.28.1"
  }
}
